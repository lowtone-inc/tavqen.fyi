---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import Pagination from '@/components/Pagination.astro';
import { getPosts, paginate } from '@/lib/posts';

// 2페이지부터 /page2/ 경로로 생성 (글이 한 페이지 분량이면 생성되지 않음)
export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const { lastPage } = paginate(posts, 1);
  return Array.from({ length: lastPage - 1 }, (_, i) => i + 2).map((n) => ({
    params: { num: String(n) },
    props: paginate(posts, n),
  }));
}) satisfies GetStaticPaths;

const { data, currentPage, lastPage } = Astro.props;
---

<BaseLayout title={`Page ${currentPage}`} crumb={`Page ${currentPage}`}>
  <div class="list">
    {data.map((post) => <PostCard post={post} />)}
  </div>
  <Pagination currentPage={currentPage} lastPage={lastPage} />
</BaseLayout>

<style>
  .list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
</style>
