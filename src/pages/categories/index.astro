---
import PageLayout from '@/layouts/PageLayout.astro';
import PostList from '@/components/PostList.astro';
import { categoryUrl } from '@/lib/url';
import { getCategoryGroups } from '@/lib/posts';

const groups = await getCategoryGroups();
---

<PageLayout title="Categories" description="카테고리별 글 모아보기">
  {
    groups.map((group) => (
      <section>
        <h2>
          <a href={categoryUrl(group.name)}>{group.name}</a>
          <span class="meta-muted">{group.posts.length}</span>
        </h2>
        <PostList posts={group.posts} />
      </section>
    ))
  }
</PageLayout>

<style>
  section {
    margin-bottom: 32px;
  }
  h2 {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 1.2rem;
  }
  h2 a:hover {
    color: var(--netflix-red);
  }
</style>
