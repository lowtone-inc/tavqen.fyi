---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description?: string;
  // breadcrumb 표시 이름 (기본은 title)
  crumb?: string;
}

const { title, description, crumb = title } = Astro.props;
---

<BaseLayout title={title} description={description} crumb={crumb}>
  <h1 class="page-title">{title}</h1>
  {description && <p class="page-desc">{description}</p>}
  <slot />
</BaseLayout>
