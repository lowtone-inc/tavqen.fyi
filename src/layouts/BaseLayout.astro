---
import BaseHead from '@/components/BaseHead.astro';
import Sidebar from '@/components/Sidebar.astro';
import Topbar from '@/components/Topbar.astro';
import { SITE } from '@/config';
import type { ArticleMeta } from '@/components/BaseHead.astro';

export interface Props {
  title?: string;
  description?: string;
  article?: ArticleMeta;
  noindex?: boolean;
  // 상단바 breadcrumb에 표시할 현재 페이지 이름
  crumb?: string;
}

const { title, description, article, noindex, crumb } = Astro.props;
---

<!doctype html>
<html lang={SITE.locale.split('-')[0]}>
  <head>
    <BaseHead title={title} description={description} article={article} noindex={noindex} />
  </head>
  <body>
    <Sidebar />
    <div class="wrapper">
      <Topbar crumb={crumb} />
      <main>
        <slot />
      </main>
      <footer>© {new Date().getFullYear()} {SITE.author}. All rights reserved.</footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --gutter: clamp(16px, 4vw, 40px);
  }
  .wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin-left: var(--sidebar-width);
  }
  main {
    flex: 1;
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 40px var(--gutter);
  }
  footer {
    padding: 24px var(--gutter);
    border-top: 1px solid var(--main-border-color);
    color: var(--text-muted-color);
    font-size: 0.8rem;
    text-align: center;
  }
  @media (max-width: 899px) {
    .wrapper {
      margin-left: 0;
    }
  }
</style>
